{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnlineBGClient",
  "version": "0.1.0",
  "identifier": "cn.hullqin.companion",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OnlineBGClient",
        "width": 1160,
        "height": 820,
        "minWidth": 640,
        "minHeight": 580
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/hosting/": "hosting/"
    }
  }
}
