{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnlineBGClient",
  "version": "../package.json",
  "identifier": "cn.hullqin.companion",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OnlineBGClient",
        "width": 1160,
        "height": 820,
        "minWidth": 640,
        "minHeight": 580,
        "create": false,
        "backgroundThrottling": "disabled"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/hosting/": "hosting/"
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzQjY1MTA0MEMzQ0U4QUQKUldTdDZEd01CRkcySXp2Y2pxY1lsQ0VjdVVtMkQwQW1UOWlRSWVMYVhRblVIYXFhcWlrek5zMDEK",
      "endpoints": [
        "https://github.com/XYXBlAcG/OnlineBGClient/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
